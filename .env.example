# =====================================================================
# LIBERTY LAKE — variables d'environnement du serveur multijoueur
# ---------------------------------------------------------------------
# Ce fichier est un MODÈLE : il ne contient aucun secret et peut être
# versionné. En ligne, les vraies valeurs se saisissent dans le tableau
# de bord de l'hébergeur (Railway → Variables, Render → Environment),
# jamais dans le code ni dans le dépôt.
#
# En local : copier ce fichier en « .env » puis lancer
#   node --env-file=.env server.js        (Node 20+)
# =====================================================================

# Port d'écoute. Railway et Render l'imposent automatiquement : ne pas
# le définir soi-même en ligne. En local, 3000 par défaut.
PORT=3000

# Origines autorisées à ouvrir une WebSocket, séparées par des virgules.
# C'est le contrôle d'origine du serveur (les en-têtes CORS du site ne
# protègent pas une WebSocket). Vide = tout accepter, à réserver au local.
ALLOWED_ORIGIN=https://mon-jeu.vercel.app,https://mon-jeu.netlify.app

# Clé d'administration exigée par /admin/salles et /admin/journal.
# Prendre une chaîne longue et aléatoire. Sans elle, ces routes sont closes.
ADMIN_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire

# Base de données optionnelle (Supabase). Sans DB_URL, le serveur tourne
# en mémoire : les parties se jouent, rien n'est archivé.
DB_URL=https://xxxxxxxxxxxx.supabase.co
DB_KEY=cle-service-role-supabase
DB_TABLE_PARTIES=parties
DB_TABLE_PROFILS=profils

# Fréquence de simulation en hertz (20 = un tick toutes les 50 ms).
TICK_HZ=20

# Nombre maximal de salles simultanées.
MAX_SALLES=40

# 1 pour que le serveur serve aussi liberty-lake.html (pratique en local
# ou sur un VPS unique). En ligne le client vient de Vercel/Netlify : 0.
SERVE_STATIC=0

# Connexions simultanees tolerees depuis une meme adresse IP (8 par defaut).
MAX_PAR_IP=8
