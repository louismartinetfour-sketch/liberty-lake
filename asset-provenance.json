      "roles": [
        {
          "description": "Conservez sa fonction, sa silhouette lisible et tous ses états de jeu actuels, avec une apparence cohérente pour chaque thème, dont une variante adaptée à l’univers zombie.",
          "id": "joueur",
          "label": "Votre personnage joueur"
        },
        {
          "description": "Réhabillez uniquement les ennemis, alliés, créatures ou personnages déjà présents, en préservant exactement leurs rôles, proportions visuelles et animations utiles dans chaque thème.",
          "id": "acteurs_gameplay",
          "label": "Vos autres acteurs de gameplay"
        },
        {
          "description": "Rendez immédiatement identifiables les objets, déclencheurs, ressources ou points d’intérêt déjà liés à vos objectifs et interactions, sans en ajouter de nouveaux.",
          "id": "objectifs_interactions",
          "label": "Vos objectifs et éléments interactifs"
        },
        {
          "description": "Déclinez l’espace jouable existant en ensembles visuels top-down cohérents pour chaque thème, avec des limites, passages et zones praticables toujours faciles à lire.",
          "id": "sols_limites",
          "label": "Vos sols, chemins et limites jouables"
        },
        {
          "description": "Remplacez ou adaptez les éléments existants qui structurent les déplacements, les collisions ou la couverture visuelle, sans multiplier les décors purement ornementaux.",
          "id": "obstacles_accessoires",
          "label": "Vos obstacles et accessoires fonctionnels"
        },
        {
          "description": "Harmonisez les cadres, jauges, marqueurs et effets de retour déjà nécessaires au gameplay avec chaque thème, tout en conservant leur placement et leur lisibilité sur navigateur.",
          "id": "interface_retours",
          "label": "Votre interface et vos retours de jeu"
        }
      ]
    },
    "overflowEvents": 0,
    "resolutions": {},
    "version": 1
  }
